# ── 必填 ───────────────────────────────────────────────────────────────────
# API Key，形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=
# 模型名称
LLM_MODEL=
# base url
LLM_BASE_URL=
# Tavily API Key，形如 tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=
# 数据库端口，root后面密钥记得修改
DATABASE_URL=mysql+pymysql://root:ia123456@127.0.0.1:3306/intervieweragent?charset=utf8mb4

# JWT 签名密钥（生成：uv run python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=
# 32 字节密钥的 base64（AES-256-GCM，加密用户自定义 API Key）
# 生成：uv run python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=

# ── 可选 ───────────────────────────────────────────────────────────────────
# GitHub token
GITHUB_TOKEN=
# 代理
HTTP_PROXY=
# ── PaddleOCR-VL 云端 OCR（扫描件 PDF 必需，文字版 PDF 不需要）──────────
# AI Studio access token；运行环境需安装 uv（提供 uvx），首次调用会下载 MCP 客户端
# 无文字层 PDF 的前 10 页会发送到 AI Studio；不安装本地 OCR 模型
PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN=
