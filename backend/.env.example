# InterviewerAgent 后端配置模板
# 用法：cp .env.example .env 后填入真实值。.env 不入库（见 .gitignore），本文件入库。
# 配置由 backend/app/config.py（pydantic-settings）统一读取，代码里不硬编码。
#
# 标「必填」的四项缺任意一项，服务启动时会直接报错并点名缺哪个 —— 不会静默跑偏。
# 没配好就留空，不要写占位符字符串（空值等于没填）。

# ── LLM（三项都必填，必须与实际接入通道一致）────────────────────────────────
# API Key，形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=
# 本团队当前走阿里云百炼 MaaS 网关，形如：
#   LLM_MODEL=deepseek-v4.1-flash
#   LLM_BASE_URL=https://ws-<实例ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 注意必须带 /compatible-mode/v1 后缀（OpenAI SDK 直接在其后拼 /chat/completions，
# 只写域名会 404）。连通性自测：uv run pytest backend/tests/test_llm_connectivity.py -s
# 若改用 DeepSeek 官方 API：base_url 填 https://api.deepseek.com，模型名以控制台为准。
# 具体值找组内已配好的同学要，或照抄自己那台机器的 backend/.env。
LLM_MODEL=
LLM_BASE_URL=

# ── 联网搜索（必填）────────────────────────────────────────────────────────
# Tavily API Key，形如 tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=

# ── 可选 ───────────────────────────────────────────────────────────────────
# GitHub token：不填则 GitHub 限流 60 次/h（一轮核实约耗 6~10 次），填了 5000 次/h
GITHUB_TOKEN=
# 国内访问 GitHub / Tavily 不通时填，如 http://127.0.0.1:7897
# 只作用于 GitHub / Tavily / 博客抓取等境外请求，别套到 LLM 网关与本地 MySQL 上
HTTP_PROXY=

# ── 数据库（不填就用下面这条默认值，与 README 的 docker 起库命令一致）────────
# 改过端口/密码/库名才需要取消注释并覆盖
#DATABASE_URL=mysql+pymysql://root:ia123456@127.0.0.1:3306/intervieweragent?charset=utf8mb4

# ── 调参 ───────────────────────────────────────────────────────────────────
# 超时、重试次数、核实轮数上限等不再走环境变量，直接改 backend/app/config.py
# 顶部的「调参常量」一节（LLM_TIMEOUT / HTTP_TIMEOUT / RESEARCH_TIMEOUT / SQL_ECHO 等）。